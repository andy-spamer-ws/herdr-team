#!/usr/bin/env bash
# outcomes-pane — continuously render the authoritative `oc` outcome list in a
# dedicated herdr pane, and refuse to run without a pinned database.
#
# Every goal workspace this bundle opens carries exactly one of these panes so
# a human watching herdr sees the real, database-backed status of every
# declared outcome — never a summary an agent typed from memory. This script
# owns no SQLite of its own: it only shells out to the outcomes skill's own
# `oc.py` (`status`, `where`) and prints what comes back.
#
# Part of the herdr-team bundle. This script may be invoked through a symlink
# (install.sh puts one in your PATH); it resolves that symlink back to the
# bundle root, though the bundle root is not otherwise needed at runtime.
#
#   outcomes-pane --db /path/to/session.db
#   outcomes-pane --db /path/to/session.db --once
#   OC_DB=/path/to/session.db outcomes-pane --once
#   outcomes-pane --db /path/to/session.db --interval 10 --oc-py /custom/oc.py
#
# The database is never discovered or guessed. `oc.py` itself falls back to
# "most recently written session" when unpinned — exactly the ambiguity this
# pane must not have, since it is one specific goal's status board. So this
# script requires --db (or OC_DB) explicitly and refuses to start without it.
#
# usage: outcomes-pane --db PATH [--oc-py PATH] [--interval SECONDS] [--once]
#
#   --db PATH        the outcomes session database to pin (required; falls
#                     back to $OC_DB if set)
#   --oc-py PATH      path to the outcomes skill's oc.py (default: $OC_PY, or
#                     $HOME/.copilot/skills/outcomes/oc.py)
#   --interval SECONDS  seconds between refreshes in the continuous loop
#                     (default: 5)
#   --once            render exactly one refresh and exit — the deterministic
#                     mode this bundle's tests and any scripted check use
#
# env:
#   OC_DB   default for --db
#   OC_PY   default for --oc-py

set -uo pipefail

# --------------------------------------------------- bundle root (symlink-safe)
# stock macOS has no `readlink -f` and no `realpath`, and /bin/bash is 3.2.57,
# so walk the symlink chain by hand. The hop cap breaks symlink cycles.
resolve_bundle_root() {
  local src="$1" dir target hops=0
  while [ -L "$src" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
      printf 'outcomes-pane: symlink cycle (or >40 hops) resolving %s\n' "$1" >&2
      return 1
    fi
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    target=$(readlink "$src")
    case "$target" in
      /*) src="$target" ;;
      *)  src="$dir/$target" ;;
    esac
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  # this script lives in <bundle>/bin/, so the bundle root is one level up
  (cd -P "$dir/.." >/dev/null 2>&1 && pwd)
}

BUNDLE_ROOT="$(resolve_bundle_root "${BASH_SOURCE[0]}")" || BUNDLE_ROOT=""

DB="${OC_DB:-}"
OC_PY_PATH="${OC_PY:-$HOME/.copilot/skills/outcomes/oc.py}"
INTERVAL=5
ONCE=0

usage() {
  cat >&2 <<'EOF'
usage: outcomes-pane --db PATH [--oc-py PATH] [--interval SECONDS] [--once]

  --db PATH           the outcomes session database to pin (required;
                       falls back to $OC_DB)
  --oc-py PATH        path to the outcomes skill's oc.py
                       (default: $OC_PY, or $HOME/.copilot/skills/outcomes/oc.py)
  --interval SECONDS  seconds between refreshes (default: 5)
  --once              render exactly one refresh and exit

env:
  OC_DB   default for --db
  OC_PY   default for --oc-py
EOF
  exit 2
}

need_value() {
  [[ $# -ge 2 ]] || { printf 'outcomes-pane: %s needs a value\n' "$1" >&2; usage; }
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --db)       need_value "$@"; DB="$2"; shift 2 ;;
    --oc-py)    need_value "$@"; OC_PY_PATH="$2"; shift 2 ;;
    --interval) need_value "$@"; INTERVAL="$2"; shift 2 ;;
    --once)     ONCE=1; shift ;;
    -h|--help)  usage ;;
    *) printf 'outcomes-pane: unknown option %s\n' "$1" >&2; usage ;;
  esac
done

[[ -n "$DB" ]] || {
  printf 'outcomes-pane: no outcomes database pinned — pass --db PATH or set OC_DB\n' >&2
  exit 1
}

if [[ ! -f "$DB" ]]; then
  printf 'outcomes-pane: outcomes database not found at %s — declare outcomes there first, or pin the right --db\n' "$DB" >&2
  exit 1
fi

if [[ ! -r "$OC_PY_PATH" ]]; then
  printf 'outcomes-pane: outcomes CLI not found at %s — install the outcomes skill, or set --oc-py/OC_PY\n' "$OC_PY_PATH" >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  printf 'outcomes-pane: python3 not on PATH — oc.py needs it to run\n' >&2
  exit 1
fi

case "$INTERVAL" in
  ''|*[!0-9]*)
    printf 'outcomes-pane: --interval must be a non-negative integer, got %q\n' "$INTERVAL" >&2
    exit 2
    ;;
esac

# Every oc.py invocation is pinned to this one database — never the "most
# recently written session" fallback oc.py otherwise applies.
export OC_DB="$DB"

render_once() {
  local ts db_where
  # Re-check every refresh: oc.py status would silently recreate a deleted
  # database as an empty one and render "no outcomes" instead of an error.
  if [[ ! -f "$DB" ]]; then
    printf 'outcomes-pane: outcomes database not found at %s — it was moved or deleted\n' "$DB" >&2
    return 1
  fi
  ts="$(date '+%Y-%m-%d %H:%M:%S')"
  if ! db_where=$(python3 "$OC_PY_PATH" where 2>&1); then
    printf 'outcomes-pane: %s where failed\n%s\n' "$OC_PY_PATH" "$db_where" >&2
    return 1
  fi

  printf 'outcomes pane — %s\n' "$ts"
  printf 'db  %s\n' "$db_where"
  printf '\n'

  local status_out status_rc
  status_out=$(python3 "$OC_PY_PATH" status 2>&1)
  status_rc=$?
  if [[ "$status_rc" -ne 0 ]]; then
    printf 'outcomes-pane: %s status failed (exit %d)\n%s\n' "$OC_PY_PATH" "$status_rc" "$status_out" >&2
    return "$status_rc"
  fi
  printf '%s\n' "$status_out"
  return 0
}

if [[ "$ONCE" == 1 ]]; then
  render_once
  exit $?
fi

# Continuous mode: refresh on an interval until the pane is closed. A failed
# render is reported and ends the loop rather than looping on a lie — a
# broken database or a moved oc.py must surface, not sit there silently.
while true; do
  clear 2>/dev/null || true
  render_once
  render_rc=$?
  if [[ "$render_rc" -ne 0 ]]; then
    exit "$render_rc"
  fi
  printf '\n(refreshing every %ss — ctrl-c to stop)\n' "$INTERVAL"
  sleep "$INTERVAL"
done
