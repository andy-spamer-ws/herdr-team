#!/usr/bin/env bash
# ccw — launch a named GitHub Copilot CLI worker in a herdr pane at a chosen role.
#
# Sibling of ccd. ccd starts an orchestrator for you; ccw starts a worker for
# the orchestrator. Every worker gets: a name, a role (the model dial) and
# skipped permissions.
#
# Part of the herdr-team bundle. This script may be invoked through a symlink
# (install.sh puts one in your PATH); it resolves that symlink back to the
# bundle root.
#
#   ccw analyse-89 --role analyse --cwd /path/to/repo
#   ccw fix-90 --role build --cwd /path/to/repo --split right --no-focus
#   ccw issue-89 --role hard --cwd /path/to/repo --new-tab issue-89-90
#   ccw probe --role mechanical --cwd . --dry-run
#
# Roles — the model is the dial, effort is a deviation:
#   mechanical  gpt-5.6-luna   --effort low
#   build       claude-sonnet-5 --effort medium
#   verify      gpt-5.6-terra  --effort medium
#   review      claude-opus-5  --effort xhigh
#   analyse     claude-opus-5  --effort xhigh
#   hard        claude-opus-5  --effort max    --context long_context
#   orchestrator gpt-5.6-sol   --effort high   --context long_context
#
# Requires herdr 0.8.0 or newer: `herdr agent start` takes --kind and --pane and
# never creates layout, so ccw acquires the pane itself (tab create or pane
# split) and then starts copilot into it.

set -euo pipefail

# --------------------------------------------------- bundle root (symlink-safe)
# stock macOS has no `readlink -f` and no `realpath`, and /bin/bash is 3.2.57,
# so walk the symlink chain by hand. The hop cap breaks symlink cycles.
resolve_bundle_root() {
  local src="$1" dir target hops=0
  while [ -L "$src" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
      printf 'ccw: symlink cycle (or >40 hops) resolving %s\n' "$1" >&2
      return 1
    fi
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    target=$(readlink "$src")
    case "$target" in
      /*) src="$target" ;;
      *)  src="$dir/$target" ;;
    esac
  done
  dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
  # this script lives in <bundle>/bin/, so the bundle root is one level up
  (cd -P "$dir/.." >/dev/null 2>&1 && pwd)
}

BUNDLE_ROOT="$(resolve_bundle_root "${BASH_SOURCE[0]}")"

# shellcheck source=../lib/roles.sh
. "$BUNDLE_ROOT/lib/roles.sh"

START_TIMEOUT="${CCW_START_TIMEOUT:-120000}"

usage() {
  cat >&2 <<'EOF'
usage: ccw <name> --role <mechanical|build|verify|review|analyse|hard|orchestrator>
           [--cwd PATH] [--split right|down] [--tab ID] [--new-tab LABEL]
           [--focus|--no-focus] [--dry-run] [-- extra copilot args]

roles:
  mechanical    gpt-5.6-luna    --effort low       rename, move, delete, mechanical edits
  build         claude-sonnet-5 --effort medium    write the code, write the tests
  verify        gpt-5.6-terra   --effort medium    run the DoD, read the diff, pass/fail
  review        claude-opus-5   --effort xhigh     adversarial pre-PR review, find the unspecified
  analyse       claude-opus-5   --effort xhigh     find out why, read across modules
  hard          claude-opus-5   --effort max       design, tricky concurrency, migrations
  orchestrator  gpt-5.6-sol     --effort high      plan and dispatch (ccd uses this)

`--tier` is accepted as an alias for `--role`.

env:
  CCW_START_TIMEOUT   ms to wait for copilot to become interactive (default 120000)
EOF
  exit 2
}

# ------------------------------------------------------------------ arg parse
NAME=""
ROLE=""
CWD="$PWD"
SPLIT=""
TAB=""
NEW_TAB=""
FOCUS="--no-focus"
DRY_RUN=0
extra=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --role|--tier) ROLE="${2:-}"; shift 2 ;;
    --cwd)      CWD="${2:-}"; shift 2 ;;
    --split)    SPLIT="${2:-}"; shift 2 ;;
    --tab)      TAB="${2:-}"; shift 2 ;;
    --new-tab)  NEW_TAB="${2:-}"; shift 2 ;;
    --focus)    FOCUS="--focus"; shift ;;
    --no-focus) FOCUS="--no-focus"; shift ;;
    --dry-run)  DRY_RUN=1; shift ;;
    -h|--help)  usage ;;
    --)         shift; extra=("$@"); break ;;
    -*)         printf 'ccw: unknown option %s\n' "$1" >&2; usage ;;
    *)
      if [[ -z "$NAME" ]]; then NAME="$1"; shift
      else printf 'ccw: unexpected argument %s\n' "$1" >&2; usage
      fi
      ;;
  esac
done

[[ -n "$NAME" ]] || { printf 'ccw: missing <name>\n' >&2; usage; }
[[ -n "$ROLE" ]] || { printf 'ccw: missing --role\n' >&2; usage; }

# herdr requires agent names to match [a-z][a-z0-9_-]{0,31} and be unique
if ! printf '%s' "$NAME" | grep -Eq '^[a-z][a-z0-9_-]{0,31}$'; then
  printf 'ccw: invalid name %s — herdr requires [a-z][a-z0-9_-]{0,31}\n' "$NAME" >&2
  exit 2
fi

# ------------------------------------------------------------------ role table
# The mapping itself lives in lib/roles.sh so ccd and ccw cannot drift apart.
if ! ROLE_FLAGS="$(roles_flags "$ROLE")"; then
  printf 'ccw: unknown role %s\n' "$ROLE" >&2; usage
fi
MODEL="$(roles_model "$ROLE")"

if [[ -n "$SPLIT" && "$SPLIT" != right && "$SPLIT" != down ]]; then
  printf 'ccw: --split must be right or down\n' >&2; usage
fi

if [[ -n "$TAB" && -n "$NEW_TAB" ]]; then
  printf 'ccw: --tab and --new-tab are mutually exclusive\n' >&2; usage
fi

# --------------------------------------------------------------- copilot argv
# Copilot has no --append-system-prompt. The SR communication addendum is
# installed once, globally, as a managed block in the Copilot instructions file
# (see install.sh) and applies to every worker without a per-launch flag.
copilot_argv=($ROLE_FLAGS --allow-all)
copilot_argv+=(${extra[@]+"${extra[@]}"})

# ------------------------------------------------------------------- dry run
if [[ "$DRY_RUN" == 1 ]]; then
  if [[ -n "$NEW_TAB" ]]; then
    printf 'herdr tab create --label %q --cwd %q --no-focus\n' "$NEW_TAB" "$CWD"
    printf '# then, with PANE_ID from .result.root_pane.pane_id:\n'
  elif [[ -n "$TAB" ]]; then
    printf 'herdr pane split --pane <first pane of %s> --direction %s --cwd %q %s\n' \
      "$TAB" "${SPLIT:-right}" "$CWD" "$FOCUS"
    printf '# then, with PANE_ID from .result.pane.pane_id:\n'
  else
    printf 'herdr pane split --current --direction %s --cwd %q %s\n' \
      "${SPLIT:-right}" "$CWD" "$FOCUS"
    printf '# then, with PANE_ID from .result.pane.pane_id:\n'
  fi
  printf 'herdr agent start %q --kind copilot --pane "$PANE_ID" --timeout %q --' "$NAME" "$START_TIMEOUT"
  for a in "${copilot_argv[@]}"; do printf ' %q' "$a"; done
  printf '\n'
  exit 0
fi

# ---------------------------------------------------------------- herdr side
command -v herdr >/dev/null 2>&1 || {
  printf 'ccw: herdr not on PATH — cannot start a worker pane\n' >&2
  exit 1
}

json_get() {
  # json_get <dotted.path> — reads stdin, prints the value or fails
  python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception as e:
    print("ccw: herdr response was not JSON: %s" % e, file=sys.stderr)
    sys.exit(1)
node = data
for key in sys.argv[1].split("."):
    if not isinstance(node, dict) or key not in node:
        print("ccw: missing %s in herdr response" % sys.argv[1], file=sys.stderr)
        print(json.dumps(data, indent=2)[:2000], file=sys.stderr)
        sys.exit(1)
    node = node[key]
print(node)
' "$1"
}

run_herdr() {
  # run_herdr <dotted.path> <herdr args...> — runs herdr, returns one JSON field
  local path="$1"; shift
  local out
  if ! out=$("$@" 2>&1); then
    printf 'ccw: %s failed\n%s\n' "$*" "$out" >&2
    return 1
  fi
  printf '%s' "$out" | json_get "$path"
}

# ------------------------------------------------------------ acquire a pane
# herdr 0.8.0's `agent start` never creates layout, so the pane must exist and
# be sitting at an interactive shell prompt before the agent goes in.
CREATED_TAB=""
if [[ -n "$NEW_TAB" ]]; then
  out=$(herdr tab create --label "$NEW_TAB" --cwd "$CWD" --no-focus 2>&1) || {
    printf 'ccw: herdr tab create failed\n%s\n' "$out" >&2; exit 1
  }
  PANE_ID=$(printf '%s' "$out" | json_get result.root_pane.pane_id) || exit 1
  TAB=$(printf '%s' "$out" | json_get result.tab.tab_id) || exit 1
  CREATED_TAB="$TAB"
elif [[ -n "$TAB" ]]; then
  # split the first pane of the named tab; splitting a busy pane is safe, the
  # new pane is always a fresh shell
  host_pane=$(herdr pane list 2>/dev/null | python3 -c '
import json, sys
try:
    panes = json.load(sys.stdin)["result"]["panes"]
except Exception:
    sys.exit(1)
for p in panes:
    if p.get("tab_id") == sys.argv[1]:
        print(p["pane_id"]); sys.exit(0)
sys.exit(1)
' "$TAB") || {
    printf 'ccw: no pane found in tab %s\n' "$TAB" >&2; exit 1
  }
  PANE_ID=$(run_herdr result.pane.pane_id \
    herdr pane split --pane "$host_pane" --direction "${SPLIT:-right}" \
      --cwd "$CWD" "$FOCUS") || exit 1
else
  if [[ -n "${HERDR_PANE_ID:-}" ]]; then
    PANE_ID=$(run_herdr result.pane.pane_id \
      herdr pane split --current --direction "${SPLIT:-right}" \
        --cwd "$CWD" "$FOCUS") || exit 1
  else
    printf 'ccw: HERDR_PANE_ID is not set — run ccw from inside a herdr pane, or pass --tab/--new-tab\n' >&2
    exit 1
  fi
fi

# ------------------------------------------------------------- start copilot
# Leaving a bare shell pane behind on failure is worse than no pane at all.
cleanup_pane() {
  herdr pane close "$PANE_ID" >/dev/null 2>&1 || true
}

start=(herdr agent start "$NAME" --kind copilot --pane "$PANE_ID"
       --timeout "$START_TIMEOUT" -- "${copilot_argv[@]}")

if ! output=$("${start[@]}" 2>&1); then
  printf 'ccw: herdr agent start failed\n%s\n' "$output" >&2
  cleanup_pane
  exit 1
fi

AGENT_NAME=$(printf '%s' "$output" | json_get result.agent.name) || { cleanup_pane; exit 1; }

printf 'started %s  pane %s  role %s  model %s' "$AGENT_NAME" "$PANE_ID" "$ROLE" "$MODEL"
[[ -n "$CREATED_TAB" ]] && printf '  tab %s' "$CREATED_TAB"
printf '\n'
