#!/usr/bin/env bash
# orchestrate-doctor — read-only readiness check for the herdr-team bundle.
#
# Runs every check, always. It never stops at the first failure, because the
# thing you want to know is the full state of the install, not the first
# thing that happens to be wrong.
#
#   PASS  the check succeeded
#   WARN  not fatal — the toolchain still runs, but something is degraded or a
#         different copy of a component is the one actually active
#   FAIL  something required is missing; the remedy is on the same line
#
# A component that is present and working but resolves outside this bundle is a
# WARN, not a FAIL. That is the expected state when this bundle sits alongside
# an existing install — nothing is broken, a different copy is just in charge.
#
# Exit status: 0 if nothing failed, 1 otherwise. Warnings never change the exit
# status.
#
# usage: orchestrate-doctor [--copilot-dir DIR]
#
#   --copilot-dir DIR  your Copilot CLI config dir (default: $HOME/.copilot)

set -uo pipefail

# --------------------------------------------------- bundle root (symlink-safe)
resolve_path() {
  local src="$1" dir target hops=0
  while [ -L "$src" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
      printf '%s' "$src"
      return 0
    fi
    dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)
    target=$(readlink "$src")
    case "$target" in
      /*) src="$target" ;;
      *)  src="$dir/$target" ;;
    esac
  done
  if dir=$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd); then
    printf '%s/%s' "$dir" "$(basename "$src")"
  else
    printf '%s' "$src"
  fi
}

SELF="$(resolve_path "${BASH_SOURCE[0]}")"
BUNDLE_ROOT="$(cd -P "$(dirname "$SELF")/.." >/dev/null 2>&1 && pwd)"

COPILOT_DIR="$HOME/.copilot"

# Must match install.sh and uninstall.sh exactly.
ADDENDUM_BEGIN='<!-- BEGIN herdr-team SR addendum (managed) -->'

usage() {
  cat >&2 <<'EOF'
usage: orchestrate-doctor [--copilot-dir DIR]

  --copilot-dir DIR  your Copilot CLI config dir (default: $HOME/.copilot)
EOF
  exit 2
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --copilot-dir) COPILOT_DIR="${2:-}"; shift 2 ;;
    -h|--help)     usage ;;
    *) printf 'orchestrate-doctor: unknown option %s\n' "$1" >&2; usage ;;
  esac
done

LIBRARY_DIR="$COPILOT_DIR/skill-library"
N_PASS=0
N_WARN=0
N_FAIL=0

pass() { printf 'PASS  %-34s %s\n' "$1" "$2"; N_PASS=$((N_PASS + 1)); }
warn() { printf 'WARN  %-34s %s\n' "$1" "$2"; N_WARN=$((N_WARN + 1)); }
fail() { printf 'FAIL  %-34s %s\n' "$1" "$2"; N_FAIL=$((N_FAIL + 1)); }

printf 'bundle       %s\n' "$BUNDLE_ROOT"
printf 'copilot dir  %s\n\n' "$COPILOT_DIR"

# ------------------------------------------------------------- 1. bash version
BASH_MAJOR="${BASH_VERSINFO[0]}"
BASH_MINOR="${BASH_VERSINFO[1]}"
if [ "$BASH_MAJOR" -gt 3 ] || { [ "$BASH_MAJOR" -eq 3 ] && [ "$BASH_MINOR" -ge 2 ]; }; then
  pass "bash version" "$BASH_VERSION"
else
  warn "bash version" "$BASH_VERSION is below 3.2 — install a newer bash (brew install bash)"
fi

# --------------------------------------------------------- 2. herdr (required)
# The dispatch shape ccw uses (agent start --kind/--pane) only exists in 0.8.0.
if command -v herdr >/dev/null 2>&1; then
  HERDR_VERSION="$(herdr --version 2>&1 | head -n 1)"
  HERDR_NUM="$(printf '%s' "$HERDR_VERSION" | grep -oE '[0-9]+\.[0-9]+' | head -n 1)"
  if [ -z "$HERDR_VERSION" ]; then
    warn "herdr on PATH" "$(command -v herdr) — 'herdr --version' printed nothing"
  elif [ -z "$HERDR_NUM" ]; then
    warn "herdr on PATH" "$(command -v herdr) — $HERDR_VERSION (could not read a version number; 0.8.0+ is required)"
  else
    HERDR_MAJOR="${HERDR_NUM%%.*}"
    HERDR_MINOR="${HERDR_NUM##*.}"
    if [ "$HERDR_MAJOR" -gt 0 ] || [ "$HERDR_MINOR" -ge 8 ]; then
      pass "herdr on PATH" "$(command -v herdr) — $HERDR_VERSION"
    else
      fail "herdr on PATH" "$HERDR_VERSION is below 0.8.0 — ccw needs 'agent start --kind/--pane'; run herdr update"
    fi
  fi
else
  fail "herdr on PATH" "herdr is a hard dependency — install it and reopen your shell"
fi

# ------------------------------------------- 2b. herdr knows the copilot kind
if command -v herdr >/dev/null 2>&1; then
  if herdr agent start --help 2>&1 | grep -q 'copilot'; then
    pass "herdr copilot kind" "'copilot' is an accepted --kind"
  else
    fail "herdr copilot kind" "this herdr build does not list 'copilot' in agent start --kind — run herdr update"
  fi
fi

# ------------------------------------------------------- 3. copilot (required)
if command -v copilot >/dev/null 2>&1; then
  pass "copilot on PATH" "$(command -v copilot)"
else
  fail "copilot on PATH" "install the GitHub Copilot CLI — ccd execs it and ccw starts it in panes"
fi

# ------------------------------------------------------- 4. python3 (required)
if command -v python3 >/dev/null 2>&1; then
  pass "python3 on PATH" "$(command -v python3)"
else
  fail "python3 on PATH" "ccd and ccw parse herdr JSON with python3 — install it"
fi

# --------------------------------------------------- 5. HERDR_ENV (info only)
if [ "${HERDR_ENV:-}" = 1 ]; then
  pass "HERDR_ENV" "1 — this shell is inside herdr"
else
  warn "HERDR_ENV" "not set — informational; you are not in a herdr pane right now"
fi

# ------------------------------------------------------ 6. addendum (required)
# Copilot has no --append-system-prompt, so the addendum is a managed block in
# the Copilot instructions file rather than a per-launch flag.
ADDENDUM_SRC="$BUNDLE_ROOT/prompts/sr_opus_5_system_prompt.md"
INSTRUCTIONS="$COPILOT_DIR/copilot-instructions.md"
if [ ! -r "$ADDENDUM_SRC" ]; then
  fail "addendum source readable" "$ADDENDUM_SRC missing from the bundle"
else
  ADDENDUM_SIZE="$(wc -c <"$ADDENDUM_SRC" | awk '{printf "%.1fK", $1/1024}')"
  pass "addendum source readable" "$ADDENDUM_SRC ($ADDENDUM_SIZE)"
fi

if [ -f "$INSTRUCTIONS" ] && grep -qF "$ADDENDUM_BEGIN" "$INSTRUCTIONS"; then
  pass "addendum installed" "$INSTRUCTIONS has the managed block"
else
  warn "addendum installed" "$INSTRUCTIONS has no herdr-team block — run ./install.sh; ccd and ccw still work, workers just lose the SR prompt"
fi

# ------------------------------------------ 7/8. installed into the copilot dir
check_installed() {
  local label="$1" dst="$2" expected="$3" actual
  if [ ! -e "$dst" ] && [ ! -L "$dst" ]; then
    fail "$label" "$dst not installed — run ./install.sh"
    return 0
  fi
  actual="$(resolve_path "$dst")"
  if [ "$actual" = "$expected" ]; then
    pass "$label" "$dst -> $actual"
  else
    warn "$label" "active copy is $actual, not this bundle — expected if the bundle is a shareable copy alongside an existing install; ./install.sh --force switches over"
  fi
}

check_library_install() {
  local label="$1" dst="$2" library_entry="$3" source="$4" first second actual
  if [ ! -L "$dst" ]; then
    fail "$label" "$dst is not a symlink — rerun ./install.sh"
    return 0
  fi
  first="$(readlink "$dst")"
  if [ "$first" != "$library_entry" ]; then
    fail "$label" "$dst points to $first, not the canonical library entry $library_entry — rerun ./install.sh --force"
    return 0
  fi
  if [ ! -L "$library_entry" ]; then
    fail "$label" "$library_entry is not a symlink into this bundle — rerun ./install.sh"
    return 0
  fi
  second="$(readlink "$library_entry")"
  actual="$(resolve_path "$library_entry")"
  if [ "$second" != "$source" ] || [ "$actual" != "$source" ]; then
    fail "$label" "$library_entry does not resolve to $source — rerun ./install.sh --force"
    return 0
  fi
  pass "$label" "$dst -> $library_entry -> $source"
}

check_registration() {
  local name="$1" output
  if ! output="$(python3 "$BUNDLE_ROOT/lib/library_registry.py" check \
      --library "$LIBRARY_DIR" --bundle "$BUNDLE_ROOT" --name "$name" 2>&1)"; then
    fail "$name registered" "$output — rerun ./install.sh"
  else
    pass "$name registered" "$LIBRARY_DIR/library.json"
  fi
}

if [ -d "$LIBRARY_DIR" ]; then
  check_library_install "orchestrator agent installed" \
    "$COPILOT_DIR/agents/orchestrator.md" \
    "$LIBRARY_DIR/agents/orchestrator.md" \
    "$BUNDLE_ROOT/agents/orchestrator.md"
  check_library_install "orchestrate skill installed" \
    "$COPILOT_DIR/skills/orchestrate" \
    "$LIBRARY_DIR/skills/orchestrate" \
    "$BUNDLE_ROOT/skills/orchestrate"
  check_library_install "pre-pr-reviewer agent installed" \
    "$COPILOT_DIR/agents/pre-pr-reviewer.md" \
    "$LIBRARY_DIR/agents/pre-pr-reviewer.md" \
    "$BUNDLE_ROOT/agents/pre-pr-reviewer.md"
  check_library_install "pre-pr-review skill installed" \
    "$COPILOT_DIR/skills/pre-pr-review" \
    "$LIBRARY_DIR/skills/pre-pr-review" \
    "$BUNDLE_ROOT/skills/pre-pr-review"

  if command -v python3 >/dev/null 2>&1; then
    check_registration orchestrator
    check_registration orchestrate
    check_registration pre-pr-reviewer
    check_registration pre-pr-review
  fi
else
  warn "canonical skill library" "$LIBRARY_DIR not found — direct-link compatibility mode is active; install librarian to enable discovery"
  check_installed "orchestrator agent installed" \
    "$COPILOT_DIR/agents/orchestrator.md" \
    "$BUNDLE_ROOT/agents/orchestrator.md"
  check_installed "orchestrate skill installed" \
    "$COPILOT_DIR/skills/orchestrate" \
    "$BUNDLE_ROOT/skills/orchestrate"
  check_installed "pre-pr-reviewer agent installed" \
    "$COPILOT_DIR/agents/pre-pr-reviewer.md" \
    "$BUNDLE_ROOT/agents/pre-pr-reviewer.md"
  check_installed "pre-pr-review skill installed" \
    "$COPILOT_DIR/skills/pre-pr-review" \
    "$BUNDLE_ROOT/skills/pre-pr-review"
fi

# ------------------------------------------------- 9/10. ccd and ccw on PATH
check_on_path() {
  local label="$1" cmd="$2" expected="$3" found actual
  if ! found="$(command -v "$cmd" 2>/dev/null)"; then
    fail "$label" "$cmd not on PATH — run ./install.sh, and put the prefix dir on PATH"
    return 0
  fi
  actual="$(resolve_path "$found")"
  if [ "$actual" = "$expected" ]; then
    pass "$label" "$found -> $actual"
  else
    warn "$label" "active copy is $actual, not this bundle — expected if the bundle is a shareable copy alongside an existing install; ./install.sh --force switches over"
  fi
}

check_on_path "ccd resolves to this bundle" ccd "$BUNDLE_ROOT/bin/ccd"
check_on_path "ccw resolves to this bundle" ccw "$BUNDLE_ROOT/bin/ccw"

# ----------------------------------------------------------------- summary
printf '\nsummary      %d pass, %d warn, %d fail\n' "$N_PASS" "$N_WARN" "$N_FAIL"

if [ "$N_FAIL" -gt 0 ]; then
  printf 'verdict      not ready — %d required check(s) failed, see the FAIL lines above\n' "$N_FAIL"
  exit 1
fi

if [ "$N_WARN" -gt 0 ]; then
  printf 'verdict      ready — with %d warning(s); nothing is broken, see the WARN lines above\n' "$N_WARN"
  exit 0
fi

printf 'verdict      ready\n'
exit 0
